{
  "name": "@mooncellwiki/prts-design-vue",
  "version": "0.1.19",
  "description": "PRTS Design 的 Vue 3 实现：输出与 CSS 实现相同的 .ak-* 结构，自带状态、键盘与可访问性；不带样式——prts.wiki 上由皮肤 / skins.arknights.components 模块提供，站外用 @mooncellwiki/prts-design-css",
  "license": "MIT",
  "type": "module",
  "homepage": "https://mooncellwiki.github.io/prts-design/guide/vue",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MooncellWiki/prts-design.git",
    "directory": "packages/vue"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "@mooncellwiki/prts-design-css": "workspace:^",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@mooncellwiki/prts-design-css": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
