{
  color: {
    $description: "1. 原始色板 --ak-{hue}-{step}（来源：官网 CSS / 游戏解包 / gamedata）；组件不直接用，经由 functional/themes 的语义令牌引用",
    neutral: {
      $description: "Neutrals · 取自游戏内 UI 灰阶（btn #313131 / panel #F5F5F5）与官网灰阶",
      $type: "color",
      "gray-0": { $value: "#ffffff" },
      "gray-50": { $value: "#f5f5f5", $description: "in-game light panel" },
      "gray-100": { $value: "#ebebeb" },
      "gray-200": { $value: "#d2d2d2", $description: "site" },
      "gray-300": { $value: "#b1b1b1" },
      "gray-400": { $value: "#8d8d8d", $description: "site" },
      "gray-500": { $value: "#626262", $description: "in-game btn_done" },
      "gray-600": { $value: "#535353" },
      "gray-700": { $value: "#3b3b3b" },
      "gray-800": { $value: "#313131", $description: "in-game standard button" },
      "gray-850": { $value: "#272727", $description: "site" },
      "gray-900": { $value: "#1d1f20", $description: "site panel" },
      "gray-950": { $value: "#181818", $description: "in-game deep" },
      "gray-1000": { $value: "#000000" },
    },
    brand: {
      $description: "Brand cyan / blue · 官网 #18D1FF，游戏内选中蓝 #0098DC",
      $type: "color",
      "cyan-200": { $value: "#7ee5ff" },
      "cyan-300": { $value: "#5ddcff" },
      "cyan-400": { $value: "#22bbff", $description: "in-game select_round" },
      "cyan-500": { $value: "#18d1ff", $description: "★ site brand accent" },
      "blue-400": { $value: "#00b0ff", $description: "in-game <ba.kw>" },
      "blue-500": { $value: "#0098dc", $description: "★ in-game UI blue / <ba.vup>" },
      "blue-600": { $value: "#0075a9", $description: "in-game toggle-on" },
      "blue-700": { $value: "#005a82" },
    },
    yellow: {
      $description: "Yellow · 稀有度星 / 商店 / 关卡名",
      $type: "color",
      "yellow-400": { $value: "#ffe75a" },
      "yellow-500": { $value: "#ffd800", $description: "★ in-game yellow (rarity #FFDE00)" },
      "yellow-600": { $value: "#ffc90e", $description: "<ga.subtitle>" },
      "yellow-700": { $value: "#eab841" },
    },
    lime: {
      $description: "Lime · SP / 官网次级强调",
      $type: "color",
      "lime-400": { $value: "#caec46", $description: "in-game SP cost" },
      "lime-500": { $value: "#c8eb21", $description: "site" },
      "lime-600": { $value: "#8fc31f", $description: "site" },
    },
    orange: {
      $description: "Orange",
      $type: "color",
      "orange-400": { $value: "#ff9433", $description: "6★" },
      "orange-500": { $value: "#f49800", $description: "<ba.rem>" },
      "orange-600": { $value: "#e5622b", $description: "in-game mission track" },
    },
    red: {
      $description: "Red",
      $type: "color",
      "red-400": { $value: "#ff6237", $description: "<ba.vdown>" },
      "red-500": { $value: "#d83c3c", $description: "<ba.enemy>" },
      "red-600": { $value: "#c82a36", $description: "in-game NEW mark" },
      "red-700": { $value: "#a40000", $description: "in-game BREAKING NEWS" },
      "red-800": { $value: "#711111", $description: "in-game confirm button" },
      "red-900": { $value: "#860101", $description: "specialization" },
      "magenta-500": { $value: "#e40043", $description: "in-game monthly card" },
    },
    "green-purple": {
      $description: "Green / Purple",
      $type: "color",
      "green-500": { $value: "#2fac78", $description: "<ba.gild>" },
      "green-400": { $value: "#4ffaa5" },
      "purple-400": { $value: "#bf96ed", $description: "4★" },
      "purple-500": { $value: "#9266b2" },
    },
    rarity: {
      $description: "Rarity · 官方色阶 (gamedata sandbox_table.charRarityColorList)",
      $type: "color",
      "rarity-1": { $value: "#bababa" },
      "rarity-2": { $value: "#d3dc35" },
      "rarity-3": { $value: "#82c5f5" },
      "rarity-4": { $value: "#bf96ed" },
      "rarity-5": { $value: "#efd691" },
      "rarity-6": { $value: "#ff9433" },
    },
    sp: {
      $description: "Skill SP 回复类型（对应游戏内技能框配色；色值取自现网 模板:技能类型）",
      $type: "color",
      "sp-auto": { $value: "#8ec31f", $description: "自动回复 INCREASE_WITH_TIME（同现网 模板:技能类型）" },
      "sp-attack": { $value: "#fc793e", $description: "攻击回复 INCREASE_WHEN_ATTACK（同现网 模板:技能类型）" },
      "sp-hit": { $value: "#f4af09", $description: "受击回复 INCREASE_WHEN_TAKEN_DAMAGE（同现网 模板:技能类型）" },
      "sp-passive-recovery": { $value: "#c289e3", $description: "被动回复：仅在特殊条件下回复技力（同现网 模板:技能类型）" },
      "sp-passive": { $value: "#808080", $description: "被动；手动 / 自动触发同色（同现网 模板:技能类型）" },
    },
  },
}
