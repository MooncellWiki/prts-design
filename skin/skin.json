{
  "name": "AKDS",
  "version": "0.1.0",
  "author": [
    "PRTS.wiki"
  ],
  "url": "https://prts.wiki/",
  "descriptionmsg": "akds-skin-desc",
  "namemsg": "skinname-akds",
  "license-name": "MIT",
  "type": "skin",
  "requires": {
    "MediaWiki": ">= 1.43.0"
  },
  "ValidSkinNames": {
    "akds": {
      "class": "SkinMustache",
      "args": [
        {
          "name": "akds",
          "template": "skin",
          "responsive": true,
          "supportsMwHeading": true,
          "toc": false,
          "wrapSiteNotice": true,
          "clientPrefEnabled": true,
          "bodyClasses": [
            "skin-arknights"
          ],
          "styles": [
            "skins.akds.base",
            "skins.akds.components",
            "skins.akds.fonts",
            "skins.akds.shell"
          ],
          "scripts": [
            "skins.akds.js"
          ],
          "messages": [
            "akds-toc-title",
            "akds-theme-os",
            "akds-theme-day",
            "akds-theme-night",
            "akds-menu",
            "akds-appearance",
            "akds-nav-screen",
            "akds-search-placeholder",
            "akds-back-to-top",
            "akds-skip",
            "akds-footer-about",
            "akds-search-label"
          ]
        }
      ]
    }
  },
  "MessagesDirs": {
    "AKDS": [
      "i18n"
    ]
  },
  "ResourceFileModulePaths": {
    "localBasePath": "resources",
    "remoteSkinPath": "AKDS/resources"
  },
  "ResourceModules": {
    "skins.akds.base": {
      "class": "MediaWiki\\ResourceLoader\\SkinModule",
      "features": {
        "normalize": true,
        "elements": true,
        "content-media": true,
        "interface-message-box": true,
        "interface-category": true,
        "toc": false,
        "logo": true
      },
      "styles": [
        "bridge-codex.css",
        "base/skin-assets.css",
        "base/root.css",
        "base/typography.css",
        "base/tables.css",
        "base/media.css",
        "base/toc.css",
        "base/collapsible.css",
        "base/references.css",
        "base/notices.css",
        "base/catlinks.css",
        "base/tabber.css",
        "base/forms.css",
        "base/special-pages.css",
        "base/print.css"
      ],
      "targets": [
        "desktop",
        "mobile"
      ]
    },
    "skins.akds.components": {
      "styles": [
        "tokens.css",
        "scope.css",
        "components/button.css",
        "components/tag.css",
        "components/chip.css",
        "components/badge.css",
        "components/card.css",
        "components/panel.css",
        "components/heading.css",
        "components/tabs.css",
        "components/message.css",
        "components/cbox.css",
        "components/tooltip.css",
        "components/dropdown.css",
        "components/dialog.css",
        "components/toast.css",
        "components/progress.css",
        "components/stat.css",
        "components/skeleton.css",
        "components/spinner.css",
        "components/empty.css",
        "components/avatar.css",
        "components/breadcrumb.css",
        "components/pagination.css",
        "components/timeline.css",
        "components/stepper.css",
        "components/form.css",
        "components/table.css",
        "components/accordion.css",
        "components/divider.css",
        "components/fab.css",
        "components/title-reset.css",
        "components/keyframes.css",
        "decor/stripes.css",
        "decor/halftone.css",
        "decor/patterns.css",
        "decor/corner.css",
        "decor/brackets.css",
        "decor/type.css",
        "decor/glyph.css",
        "decor/inverse.css",
        "decor/bilingual.css",
        "decor/chevrons.css",
        "arknights/rarity.css",
        "arknights/profession.css",
        "arknights/elite.css",
        "arknights/potential.css",
        "arknights/level.css",
        "arknights/phase-tabs.css",
        "arknights/trust.css",
        "arknights/pot-list.css",
        "arknights/op-card.css",
        "arknights/op-row.css",
        "arknights/item.css",
        "arknights/materials.css",
        "arknights/skill.css",
        "arknights/sp.css",
        "arknights/skill-levels.css",
        "arknights/skill-sheet.css",
        "arknights/skill-matrix.css",
        "arknights/talent-table.css",
        "arknights/talent.css",
        "arknights/rich-text.css",
        "arknights/attrs.css",
        "arknights/kv.css",
        "arknights/range.css",
        "arknights/module.css",
        "arknights/voice.css",
        "arknights/dossier.css",
        "arknights/archive.css",
        "arknights/dialogue.css",
        "arknights/stage.css",
        "arknights/camp.css",
        "arknights/enemy.css",
        "arknights/event.css",
        "arknights/news.css",
        "arknights/hero.css",
        "arknights/table-numerals.css",
        "utilities.css",
        "forced-colors.css"
      ],
      "targets": [
        "desktop",
        "mobile"
      ]
    },
    "skins.akds.fonts": {
      "styles": [
        "fonts.css"
      ],
      "targets": [
        "desktop",
        "mobile"
      ]
    },
    "skins.akds.shell": {
      "styles": [
        "chrome/shell.css",
        "chrome/header.css",
        "chrome/local-nav.css",
        "chrome/keyart.css",
        "chrome/layout.css",
        "chrome/sidebar.css",
        "chrome/sidebar-tree.css",
        "chrome/page-header.css",
        "chrome/body.css",
        "chrome/toc.css",
        "chrome/footer.css",
        "chrome/theme-toggle.css",
        "chrome/search-palette.css",
        "chrome/special-pages.css",
        "chrome/responsive.css"
      ],
      "targets": [
        "desktop",
        "mobile"
      ]
    },
    "skins.akds.tokens": {
      "styles": [
        "tokens.css",
        "scope.css"
      ],
      "targets": [
        "desktop",
        "mobile"
      ]
    },
    "skins.akds.js": {
      "packageFiles": [
        "skin.js",
        "sidebar-tree.js",
        "search-palette.js",
        "search-providers.js"
      ],
      "dependencies": [
        "mediawiki.user",
        "mediawiki.util",
        "mediawiki.cookie",
        "mediawiki.api"
      ],
      "messages": [
        "akds-toc-title",
        "akds-search-label",
        "akds-search-placeholder",
        "akds-search-recent",
        "akds-search-pages",
        "akds-search-modes",
        "akds-search-fulltext",
        "akds-search-fulltext-desc",
        "akds-search-empty-title",
        "akds-search-empty-desc",
        "akds-search-shortcuts",
        "akds-search-noresults",
        "akds-search-noresults-desc",
        "akds-search-error",
        "akds-search-results",
        "akds-search-redirect",
        "akds-search-edit",
        "akds-search-hint-navigate",
        "akds-search-hint-open",
        "akds-search-hint-go",
        "akds-search-hint-fulltext",
        "akds-search-hint-close",
        "akds-search-hint-clear",
        "akds-search-hint-back",
        "akds-search-hint-commands",
        "akds-search-close",
        "akds-search-clear",
        "akds-search-back",
        "akds-search-remove",
        "akds-search-mode-action",
        "akds-search-mode-action-desc",
        "akds-search-mode-action-placeholder",
        "akds-search-mode-category",
        "akds-search-mode-category-desc",
        "akds-search-mode-category-placeholder",
        "akds-search-mode-category-thispage",
        "akds-search-mode-user",
        "akds-search-mode-user-desc",
        "akds-search-mode-user-placeholder",
        "akds-search-mode-user-row",
        "akds-search-mode-file",
        "akds-search-mode-file-desc",
        "akds-search-mode-file-placeholder"
      ]
    }
  },
  "ClientPreferences": {
    "skin-theme": {
      "options": [
        "os",
        "day",
        "night"
      ],
      "default": "os",
      "callback": "skins.akds.js"
    }
  },
  "config": {
    "AKDSDefaultTheme": {
      "value": "os",
      "description": "os | day | night"
    },
    "AKDSHeaderNavPortlet": {
      "value": "navigation",
      "description": "Which sidebar portlet id renders as the primary header nav"
    },
    "AKDSSearchPalette": {
      "value": true,
      "description": "Floating command-palette search (search-palette.js). Set false to keep the plain header form. Exposed to JS as wgAKDSSearchPalette."
    }
  },
  "manifest_version": 2
}
