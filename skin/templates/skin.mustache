{{! AKDS · skin.mustache — 与 src/skin.css 的类名一一对应；保留 MW 标准 id 以兼容 Gadget }}
<a class="ak-skip" href="#content">{{msg-akds-skip}}</a>

<header class="ak-header" id="mw-head">
  <div class="ak-header__inner">
    <a class="ak-header__logo" href="{{link-mainpage}}" {{{html-logo-attributes}}}>
      {{#data-logos.icon}}<img src="{{data-logos.icon}}" alt="" class="ak-glyph">{{/data-logos.icon}}
      <span class="ak-header__wordmark">{{msg-sitetitle}}<small>{{msg-tagline}}</small></span>
    </a>
    {{! 搜索：无 JS 时是这条真表单；有 JS 时 search-palette.js 把它换成 button.ak-search-trigger，并把表单本身搬进悬浮面板（#searchform / #searchInput 保留） }}
    {{#data-search-box}}
    <form class="ak-header__search ak-search" role="search" action="{{form-action}}" id="searchform">
      <svg class="ak-search__icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" d="M10.5 3a7.5 7.5 0 1 1 0 15 7.5 7.5 0 0 1 0-15zM16 16l5 5"/></svg>
      {{{html-input}}}
      <span class="ak-search__kbd">/</span>
      {{{html-button-search-fallback}}}
    </form>
    {{/data-search-box}}
    {{! 手机（≤639）：搜索收成主行里的图标按钮，同样打开悬浮面板；≥640 由 CSS 隐藏 }}
    <button type="button" class="ak-btn ak-btn--icon ak-header__search-toggle ak-only-mobile" aria-label="{{msg-akds-search-label}}" aria-haspopup="dialog"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" d="M10.5 3a7.5 7.5 0 1 1 0 15 7.5 7.5 0 0 1 0-15zM16 16l5 5"/></svg></button>
    {{! 页眉不放站点级主导航：MediaWiki:Sidebar 首个门户只在侧栏渲染一次（与侧栏重复的顶栏已去掉）。
        <1120：工具（外观 / 通知 / 用户菜单）收进 ≡ 拉下、贴主行右下沿的卡片 .ak-header__screen；桌面它 display:contents，子项直接参与主行网格。
        开合纯 CSS：input.ak-nav-cb 必须在卡片与 label.ak-header__burger 之前（~ 联动）；JS 只补 Esc / 选中锚点 / 点卡片外 / 回到桌面宽度时收起。DOM 只此一份 → Echo / #p-personal 的 id 不重复。 }}
    <input type="checkbox" id="ak-nav-toggle" class="ak-nav-cb">
    <div class="ak-header__screen" id="ak-nav-screen">
      <div class="ak-header__tools">
        <div class="ak-header__tool">
          <span class="ak-header__tool-label" id="ak-theme-label">{{msg-akds-appearance}}</span>
          <div class="ak-theme-toggle" role="group" aria-labelledby="ak-theme-label">
            <button data-theme="os" title="{{msg-akds-theme-os}}">◐</button>
            <button data-theme="day" title="{{msg-akds-theme-day}}">☼</button>
            <button data-theme="night" title="{{msg-akds-theme-night}}">☾</button>
          </div>
        </div>
        {{#data-portlets.data-notifications}}<div id="{{id}}" class="ak-header__notifications {{class}}">{{{html-items}}}</div>{{/data-portlets.data-notifications}}
        {{#data-portlets.data-user-menu}}
        <div class="ak-dropdown" id="p-personal"><details><summary class="ak-btn ak-btn--ghost ak-header__user">{{label}}</summary><ul class="ak-menu ak-menu--right">{{{html-items}}}</ul></details></div>
        {{/data-portlets.data-user-menu}}
      </div>
    </div>
    <label class="ak-header__burger" for="ak-nav-toggle"><span class="ak-header__burger-icon" aria-hidden="true"><i></i><i></i><i></i></span><span class="ak-sr-only">{{msg-akds-nav-screen}}</span></label>
  </div>

  {{! 二级吸顶栏：<1400 出现；页眉主行向下滚动收起后它仍贴顶 }}
  <div class="ak-local-nav">
    <button type="button" class="ak-local-nav__btn ak-local-nav__menu" aria-controls="ak-sidebar" aria-expanded="false"><svg class="ak-icon" aria-hidden="true"><use href="#i-menu"/></svg>{{msg-akds-menu}}</button>
    {{#data-toc}}
    <input type="checkbox" id="ak-toc-toggle" class="ak-toc-cb">
    <label class="ak-local-nav__btn ak-local-nav__toc" for="ak-toc-toggle">{{msg-akds-toc-title}}<span class="ak-local-nav__chevron" aria-hidden="true"></span></label>
    {{/data-toc}}
  </div>
</header>

{{! 头图带（Key Visual）：默认 --ak-keyart-h: 0 不占位；活动主题（Gadget / MediaWiki:Common.css）设 --ak-keyart-image / --ak-keyart-h 即出现，见 tokens.css §2d }}
<div class="ak-keyart" aria-hidden="true"><div class="ak-keyart__inner"></div></div>

<div class="ak-layout{{^data-toc}} ak-layout--no-toc{{/data-toc}}">
  {{! 侧栏：多层导航由 resources/sidebar-tree.js 增强（li > ul 任意深度 → 树形展开 + 桌面悬停飞出；data-flyout="off" 可关闭飞出）。
      #mw-panel 保留给站点脚本兼容（PRTS 现有内联脚本把 #MenuSidebar 移入 #mw-panel 并读取 #p-tb ul）。 }}
  <aside class="ak-sidebar" id="ak-sidebar" aria-label="{{msg-navigation-heading}}">
    <button class="ak-btn ak-btn--sm ak-sidebar__close ak-only-mobile" aria-label="close">✕</button>
    <div class="ak-sidebar__panel" id="mw-panel">
    {{#data-portlets-sidebar.data-portlets-first}}
    <div class="ak-portlet ak-portlet--grid" id="{{id}}"><h3 class="ak-portlet__title">{{label}}</h3><ul>{{{html-items}}}</ul></div>
    {{/data-portlets-sidebar.data-portlets-first}}
    {{#data-portlets-sidebar.array-portlets-rest}}
    <div class="ak-portlet ak-portlet--collapsible {{class}}" id="{{id}}"><h3 class="ak-portlet__title">{{label}}</h3><ul>{{{html-items}}}</ul>{{{html-after-portal}}}</div>
    {{/data-portlets-sidebar.array-portlets-rest}}
    {{#data-portlets.data-languages}}<div class="ak-portlet ak-portlet--collapsible" id="{{id}}"><h3 class="ak-portlet__title">{{label}}</h3><ul>{{{html-items}}}</ul></div>{{/data-portlets.data-languages}}
    </div>
    <div class="ak-sidebar__foot">{{msg-akds-toc-title}}</div>
  </aside>

  <main class="ak-main" id="content" role="main">
    <div class="ak-main__inner">
      <header class="ak-page-header">
        <div class="ak-page-header__top">
          {{#html-subtitle}}<div id="contentSub">{{{html-subtitle}}}</div>{{/html-subtitle}}
          {{{html-indicators}}}
        </div>
        {{{html-title-heading}}}
        <div class="ak-page-header__bar">
          {{#data-portlets.data-namespaces}}<ul class="ak-page-tabs" id="{{id}}">{{{html-items}}}</ul>{{/data-portlets.data-namespaces}}
          {{#data-portlets.data-views}}<ul class="ak-page-tabs" id="{{id}}">{{{html-items}}}</ul>{{/data-portlets.data-views}}
          {{#data-portlets.data-actions}}<ul class="ak-page-tabs ak-page-tabs--actions" id="{{id}}">{{{html-items}}}</ul>{{/data-portlets.data-actions}}
          {{#data-portlets.data-variants}}<ul class="ak-page-tabs" id="{{id}}">{{{html-items}}}</ul>{{/data-portlets.data-variants}}
        </div>
      </header>
      {{! 目录：紧跟页面标题。≥1400 由 CSS 抬进 .ak-main 右侧导轨（粘性）；<1400 变成二级吸顶栏拉下的浮层（开关是上面那个 .ak-toc-cb） }}
      {{#data-toc}}
      <aside class="ak-toc" id="ak-toc" aria-labelledby="ak-toc-label">
        <a class="ak-toc__top" href="#"><svg class="ak-icon" aria-hidden="true"><use href="#i-up"/></svg>{{msg-akds-back-to-top}}</a>
        <div class="ak-toc__inner">
          <div class="ak-toc__title" id="ak-toc-label">{{msg-akds-toc-title}}</div>
          <div class="ak-toc__progress" aria-hidden="true"><i></i></div>
          <ul class="ak-toc__list" data-auto-toc>{{#array-sections}}<li class="toclevel-{{toclevel}}"><a href="#{{anchor}}">{{{line}}}</a></li>{{/array-sections}}</ul>
        </div>
      </aside>
      {{/data-toc}}
      <div class="ak-body" id="bodyContent">
        {{{html-site-notice}}}
        {{{html-user-message}}}
        {{{html-undelete-link}}}
        <div class="mw-body-content" id="mw-content-text" lang="{{page-langcode}}" dir="{{page-dir}}">{{{html-body-content}}}</div>
        {{{html-after-content}}}
        {{! data-footer.* 只有 array-items（核心 formatFooterDataForCurrentSpec 已剥掉 html-items / label） }}
        {{#data-footer.data-info}}<ul class="ak-body-foot" id="{{id}}">{{#array-items}}<li id="{{id}}">{{{html}}}</li>{{/array-items}}</ul>{{/data-footer.data-info}}
      </div>
      {{{html-categories}}}
    </div>
  </main>
</div>

<footer class="ak-footer" id="footer">
  <div class="ak-footer__inner">
    <div class="ak-footer__brand"><span class="ak-header__wordmark">{{msg-sitetitle}}<small>{{msg-tagline}}</small></span><p>{{msg-sitesubtitle}}</p></div>
    {{! 站点链接（隐私 / 关于 / 免责声明 + SkinAddFooterLinks 钩子加的 ICP、手机版等） }}
    {{#data-footer.data-places}}<div class="ak-footer__col"><h4>{{msg-akds-footer-about}}</h4><ul id="{{id}}"{{#className}} class="{{.}}"{{/className}}>{{#array-items}}<li id="{{id}}">{{{html}}}</li>{{/array-items}}</ul></div>{{/data-footer.data-places}}
  </div>
  {{! 底栏：左 = 站名 + 皮肤；右 = $wgFooterIcons 徽章（结构同 Vector/Citizen：ul#footer-icons > li#footer-*ico > a > img；见 skin.css .ak-footer__icons） }}
  <div class="ak-footer__bottom">
    <div class="ak-footer__bottom-text"><span>{{msg-sitetitle}}</span><span class="ak-en">Skin AKDS</span></div>
    {{#data-footer.data-icons}}<ul class="ak-footer__icons{{#className}} {{.}}{{/className}}" id="{{id}}">{{#array-items}}<li id="{{id}}">{{{html}}}</li>{{/array-items}}</ul>{{/data-footer.data-icons}}
  </div>
  <span class="ak-watermark" aria-hidden="true">{{msg-sitetitle}}</span>
</footer>
<button class="ak-fab" aria-label="{{msg-akds-back-to-top}}">↑</button>
{{{html-printtail}}}
