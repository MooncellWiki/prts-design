{
  "name": "@mooncellwiki/akds-css",
  "version": "0.1.0",
  "description": "AKDS 的 CSS 实现：令牌 · 作用域根 · 通用 / 方舟组件 · 工具类（默认入口 standalone.css，任何页面可用）；MediaWiki 内容样式（base/）也在包里。不含字体与游戏素材——prts.wiki 皮肤 Skin:Arknights 的全套见仓库",
  "license": "MIT",
  "homepage": "https://mooncellwiki.github.io/prts-design/guide/vue",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MooncellWiki/prts-design.git",
    "directory": "packages/css"
  },
  "exports": {
    ".": "./src/standalone.css",
    "./standalone.css": "./src/standalone.css",
    "./tokens.css": "./src/tokens.css",
    "./scope.css": "./src/scope.css",
    "./bridge-codex.css": "./src/bridge-codex.css",
    "./base/*": "./src/base/*",
    "./components/*": "./src/components/*",
    "./decor/*": "./src/decor/*",
    "./arknights/*": "./src/arknights/*",
    "./utilities.css": "./src/utilities.css",
    "./forced-colors.css": "./src/forced-colors.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "!src/fonts",
    "!src/fonts.css",
    "!src/img",
    "!src/base/skin-assets.css",
    "!src/charinfo.css",
    "!src/chrome/demo-theme.css"
  ],
  "style": "./src/standalone.css",
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  }
}
