{
  theme: {
    background: {
      $description: "背景 / 表面",
      $type: "color",
      "bg-canvas": { $value: "#0f0f10" },
      "bg-surface": { $value: "#1a1b1c" },
      "bg-surface-2": { $value: "#232425" },
      "bg-surface-3": { $value: "#2d2e30" },
      "bg-inset": { $value: "#141516" },
      "bg-hover": { $value: "rgba(255, 255, 255, 0.06)" },
      "bg-active": { $value: "rgba(255, 255, 255, 0.11)" },
      "bg-inverse": { $value: "{color.neutral.gray-0}" },
      "bg-overlay": { $value: "rgba(0, 0, 0, 0.7)" },
    },
    foreground: {
      $description: "文字",
      $type: "color",
      fg: { $value: "#f0f0f0" },
      "fg-secondary": { $value: "#c9c9c9" },
      "fg-muted": { $value: "{color.neutral.gray-400}" },
      "fg-subtle": { $value: "#6f7071" },
      "fg-disabled": { $value: "#4a4b4c" },
      "fg-inverse": { $value: "{color.neutral.gray-950}" },
    },
    accent: {
      $description: "强调色：亮色 = 游戏内蓝 #0098DC，暗色 = 官网青 #18D1FF；次强调 = 黄",
      $type: "color",
      accent: { $value: "{color.brand.cyan-500}", $description: "暗色下用官网青 #18D1FF" },
      "accent-hover": { $value: "{color.brand.cyan-200}" },
      "accent-fg": { $value: "#000000" },
      "accent-subtle": { $value: "rgba(24, 209, 255, 0.10)" },
      "accent-muted": { $value: "rgba(24, 209, 255, 0.30)" },
      "accent-2": { $value: "{color.yellow.yellow-500}" },
      "accent-2-fg": { $value: "#000000" },
    },
    link: {
      $description: "链接",
      $type: "color",
      link: { $value: "{color.brand.cyan-300}" },
      "link-hover": { $value: "{color.brand.cyan-200}" },
      "link-visited": {
        $value: "#3f8ea4",
        $description: "已访问 = 青 #5ddcff × 62% + 画布 #0f0f10 × 38%（视觉上就是「62% 透明的链接色」，写成实色）；黑底 5:1、surface 4.6:1",
      },
      "link-new": { $value: "#ff6b6b" },
      "link-external": { $value: "{color.brand.cyan-300}" },
    },
    border: {
      $description: "边框 / 焦点 / 选区 / 高亮",
      $type: "color",
      border: { $value: "#2f3133" },
      "border-subtle": { $value: "#262729" },
      "border-strong": { $value: "#4a4c4f" },
      "border-accent": { $value: "{color.brand.cyan-500}" },
      focus: { $value: "{color.brand.cyan-500}" },
      selection: { $value: "rgba(24, 209, 255, 0.28)" },
      "mark-bg": { $value: "rgba(24, 209, 255, 0.20)" },
    },
    status: {
      $description: "状态色",
      $type: "color",
      info: { $value: "{color.brand.cyan-300}" },
      "info-bg": { $value: "rgba(24, 209, 255, 0.10)" },
      success: { $value: "#4fd18f" },
      "success-bg": { $value: "rgba(47, 172, 120, 0.14)" },
      warning: { $value: "#ffb340" },
      "warning-bg": { $value: "rgba(244, 152, 0, 0.14)" },
      danger: { $value: "#ff5c5c" },
      "danger-bg": { $value: "rgba(216, 60, 60, 0.14)" },
    },
    "rich-text": {
      $description: "Rich text（游戏内 <color> 标签）· 暗色下即游戏原值",
      $type: "color",
      "rt-vup": { $value: "{color.brand.blue-500}" },
      "rt-vdown": { $value: "{color.red.red-400}" },
      "rt-rem": { $value: "{color.orange.orange-500}" },
      "rt-kw": { $value: "{color.brand.blue-400}" },
      "rt-imp": { $value: "#ff3b3b" },
      "rt-drop": { $value: "#36acff" },
      "rt-enemy": { $value: "{color.red.red-500}" },
      "rt-gild": { $value: "{color.green-purple.green-500}" },
      "rt-acrem": { $value: "#8a8a8a" },
      "rt-level": { $value: "#ffde00" },
    },
    "rarity-text": {
      $description: "Rarity text-safe · 暗色下直接用稀有度原色",
      $type: "color",
      "rarity-1-text": { $value: "{color.rarity.rarity-1}" },
      "rarity-2-text": { $value: "{color.rarity.rarity-2}" },
      "rarity-3-text": { $value: "{color.rarity.rarity-3}" },
      "rarity-4-text": { $value: "{color.rarity.rarity-4}" },
      "rarity-5-text": { $value: "{color.rarity.rarity-5}" },
      "rarity-6-text": { $value: "{color.rarity.rarity-6}" },
    },
    shadow: {
      $description: "阴影",
      $type: "shadow",
      "shadow-sm": { $value: "0 1px 2px rgba(0,0,0,.4)" },
      "shadow-md": { $value: "0 4px 14px rgba(0,0,0,.5), 0 1px 3px rgba(0,0,0,.4)" },
      "shadow-lg": { $value: "0 16px 40px rgba(0,0,0,.6), 0 2px 6px rgba(0,0,0,.4)" },
      "shadow-accent": { $value: "0 0 0 3px {theme.accent.accent-subtle}" },
    },
    decoration: {
      $description: "装饰：白线稿反相 / 斜纹 / 网格 / 网点 / 滚动条",
      "glyph-filter": { $value: "none" },
      "glyph-filter-inverse": { $value: "invert(1)" },
      "stripe-color": { $value: "rgba(255,255,255,.07)" },
      "grid-color": { $value: "rgba(255,255,255,.05)" },
      "halftone-color": { $value: "rgba(255,255,255,.16)" },
      scrollbar: { $value: "#3b3d40" },
    },
  },
}
